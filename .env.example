# Salin file ini menjadi .env (jangan commit .env)
# Jalur A (PRD/demo tertutup): Gemini Developer API langsung
GEMINI_API_KEY=
# Daftar model dipisah koma; dicoba berurutan saat 404 (model dicabut) atau
# 429 (kuota harian free tier habis). Model pertama adalah model utama.
GEMINI_MODEL=

# Cadangan OpenAI ketika Gemini gagal (API key dari platform OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Contoh GEMINI_MODEL dengan rotasi (kuota gratis 20 request/hari/model):
# GEMINI_MODEL=gemini-3.1-flash-lite,gemini-3.8-flash,gemini-flash-latest
